{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stiksound.local/schemas/stiksound-project-1.0.schema.json",
  "title": "StikSound project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "stickers",
    "audios",
    "associations",
    "export"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "stickers": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/sticker" }
    },
    "audios": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/audio" }
    },
    "associations": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/association" }
    },
    "active_association_id": {
      "type": ["string", "null"]
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "target"],
      "properties": {
        "profile": {
          "enum": ["video-mp4", "video-webm-alpha", "sound-bundle", "standard-webp", "native-sound-sticker"]
        },
        "target": {
          "const": "whatsapp"
        }
      }
    },
    "bundle": { "$ref": "#/$defs/bundle" }
  },
  "$defs": {
    "sticker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "source_name",
        "format",
        "width",
        "height",
        "has_alpha",
        "animated",
        "edit"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64 },
        "file": { "$ref": "#/$defs/assetPath" },
        "source_name": { "type": "string", "maxLength": 255 },
        "format": { "enum": ["png", "jpeg", "webp", "gif", "mp4", "mov", "webm"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "has_alpha": { "type": "boolean" },
        "animated": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 180000 },
        "edit": { "$ref": "#/$defs/stickerEdit" }
      }
    },
    "stickerEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fit", "offset_x", "offset_y", "scale", "stroke"],
      "properties": {
        "fit": { "enum": ["contain"] },
        "offset_x": { "type": "integer", "minimum": -512, "maximum": 512 },
        "offset_y": { "type": "integer", "minimum": -512, "maximum": 512 },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 4 },
        "stroke": { "enum": ["none", "white-8px"] },
        "matte_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "crop_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "crop_y": { "type": "number", "minimum": 0, "maximum": 1 },
        "video_start_ms": { "type": "number", "minimum": 0, "maximum": 60000 }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "source_name",
        "format",
        "duration_ms",
        "sample_rate",
        "channels",
        "source"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64 },
        "file": { "$ref": "#/$defs/assetPath" },
        "source_name": { "type": "string", "maxLength": 255 },
        "format": { "enum": ["mp3", "wav", "ogg", "m4a", "aac"] },
        "duration_ms": { "type": "integer", "minimum": 100, "maximum": 180000 },
        "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
        "channels": { "type": "integer", "minimum": 1, "maximum": 8 },
        "source": { "$ref": "#/$defs/audioSource" }
      }
    },
    "audioSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["local", "myinstants", "video-track"] },
        "page_url": { "type": ["string", "null"], "maxLength": 2048 },
        "media_url": { "type": ["string", "null"], "maxLength": 2048 },
        "title": { "type": ["string", "null"], "maxLength": 120 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "myinstants" } },
            "required": ["type"]
          },
          "then": { "required": ["media_url"] }
        }
      ]
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sticker_id",
        "audio_id",
        "start_ms",
        "end_ms",
        "volume",
        "fade_in_ms",
        "fade_out_ms"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 4, "maxLength": 64 },
        "sticker_id": { "type": "string" },
        "audio_id": { "type": "string" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "fade_in_ms": { "type": "integer", "minimum": 0 },
        "fade_out_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "assetPath": {
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9._-]+$"
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "created_at",
        "files",
        "audio_encoding",
        "limits",
        "whatsapp_native"
      ],
      "properties": {
        "kind": { "const": "sound-bundle" },
        "created_at": { "type": "string", "format": "date-time" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sticker", "audio"],
          "properties": {
            "sticker": { "const": "sticker.webp" },
            "audio": { "const": "sound.ogg" }
          }
        },
        "audio_encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container", "codec", "channels", "sample_rate", "bitrate_bps"],
          "properties": {
            "container": { "const": "ogg" },
            "codec": { "const": "opus" },
            "channels": { "const": 1 },
            "sample_rate": { "const": 48000 },
            "bitrate_bps": { "const": 64000 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sticker_px", "max_static_bytes", "max_audio_ms"],
          "properties": {
            "sticker_px": { "const": 512 },
            "max_static_bytes": { "const": 102400 },
            "max_audio_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 }
          }
        },
        "whatsapp_native": { "const": false }
      }
    }
  }
}
